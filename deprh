#!/bin/bash
# Full MaaS + AGC bring-up for the tenant external-model e2e suite
# (opendatahub-tests tests/ai_gateway/models_as_a_service/).
#
# Images (all from local checkouts):
#   maas-api / maas-controller / discovery  <- models-as-a-service @ jr_101609
#   ai-gateway-controller                   <- ai-gateway-controller @ jr_pred
#   praxis-extproc                          <- praxis-extproc @ 4656978 (commit pinned by
#                                              the AGC's vendored praxis config; the official
#                                              EA image lacks the headers_present field and
#                                              crashloops on it)
#
# The AIGateway DSC component is intentionally left OFF (no AI_GATEWAY_OPERATOR_IMAGE):
# the AIGC companion below deploys the controller directly, so no operator reverts
# the custom AGC image, the AIGuardrail CRD, or the ExternalModel CRD.

set -euo pipefail
cd "$(dirname "$0")"

# ── 1. Platform: RHOAI operator + MaaS with custom images ──────────────────
MAAS_DISCOVERY_ENABLED=false \
REMOVE_MAAS_IPP=false \
INFRA_NAMESPACE=AUTO \
MAAS_API_IMAGE=quay.io/jrhyness/maas-api:test \
MAAS_CONTROLLER_IMAGE=quay.io/jrhyness/maas-controller:test \
MAAS_DISCOVERY_IMAGE=quay.io/jrhyness/odh-maas-discovery:test \
./scripts/deploy.sh --operator-type rhoai

# ── 2. Re-assert jr_101609 CRDs (idempotent; deploy.sh Phase 1 already
#       applied them, this guards against any bundle stomp) ─────────────────
kubectl apply -k deployment/base/maas-controller/crd
kubectl wait --for condition=established \
  crd/externalmodels.inference.opendatahub.io --timeout=180s

# ── 3. AIGC companion: custom AGC + matching praxis extproc ────────────────
# Clones the fork's jr_pred (which vendors the praxis config requiring
# headers_present) and runs its deploy-ai-gateway-controller.sh: applies the
# AIGuardrail CRD + clusterrole + controller deployment, sets both
# payload-processing and payload-pre-processing to PRAXIS_EXTPROC_IMAGE, and
# waits for them to go ready.
AI_GATEWAY_CONTROLLER_IMAGE=quay.io/jrhyness/ai-gateway-controller:test \
PRAXIS_EXTPROC_IMAGE=quay.io/jrhyness/praxis-extproc:test \
AIGC_GIT_URL=https://github.com/jrhyness/ai-gateway-controller.git \
AIGC_GIT_REF=jr_pred \
AI_GATEWAY_CONTROLLER_NAMESPACE=redhat-ods-applications \
GATEWAY_NAMESPACE=openshift-ingress \
GATEWAY_NAME=maas-default-gateway \
bash test/e2e/scripts/deploy-aigc-companion.sh

# ── 4. GatewayClass the gateway tests expect ───────────────────────────────
# Only the class from deployment/base/networking/odh/odh-gateway-api.yaml —
# MaaS creates its own Gateway (maas-default-gateway), so skip the
# openshift-ai-inference Gateway also in that file.
kubectl apply -f - <<'EOF'
apiVersion: gateway.networking.k8s.io/v1
kind: GatewayClass
metadata:
  name: openshift-default
spec:
  controllerName: "openshift.io/gateway-controller/v1"
EOF

echo "✅ MaaS + AGC bring-up complete"
